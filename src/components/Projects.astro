            </div>

            <!-- Título del Proyecto -->
            <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-4 font-heading">
              Sistema de Gestión Integral &amp; Flotas: ServiML
            </h3>

            <!-- Descripción de contexto del negocio -->
            <p class="text-zinc-300 text-sm sm:text-base leading-relaxed font-sans">
