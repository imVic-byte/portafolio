---
// Hero Section: Inspirado en la tarjeta de alta conversión "Hablemos de tu Negocio, No de Tecnicismos"
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-28 overflow-hidden border-b border-white/5">
  
  <!-- Texto Monumental de Fondo Delineado (Estilo AutoRelay) -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none select-none z-0">
    <span class="text-7xl sm:text-9xl lg:text-[14rem] font-bold font-heading tracking-widest text-outline-red opacity-20 whitespace-nowrap block">
      DIRECT
    </span>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Contenedor Principal Centrado con Estilo Obsidian Glass & Glow Carmesí -->
    <div class="rounded-3xl obsidian-card p-8 sm:p-14 md:p-16 text-center flex flex-col items-center relative overflow-hidden border border-white/10 shadow-[0_0_50px_-15px_rgba(239,68,68,0.2)]">
      
      <!-- Halo de resplandor sutil superior -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-48 bg-red-600/15 blur-3xl pointer-events-none"></div>

      <!-- Logotipo Oficial Circular del Usuario con Halo Carmesí -->
      <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-black border border-red-500/40 flex items-center justify-center p-1.5 shadow-2xl shadow-red-950/60 mb-6 transition-transform duration-300 hover:scale-105 hover:border-red-500">
        <div class="absolute inset-0 rounded-full bg-red-500/20 blur-md pointer-events-none"></div>
        <img
          src="/logo.webp"
          alt="Logo Oficial"
          class="w-full h-full object-contain relative z-10"
          width="80"
          height="80"
          loading="eager"
        />
      </div>

      <!-- Badge Superior de Consultoría Directa -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#030304] border border-red-500/30 text-xs font-mono text-red-400 uppercase tracking-wider mb-6 shadow-[0_0_12px_rgba(239,68,68,0.15)]">
        <span class="w-2 h-2 rounded-full bg-red-500 shadow-[0_0_8px_#ff2e2e] animate-pulse"></span>
        <span>CONSULTORÍA DIRECTA // SIN COMPROMISO</span>
      </div>

      <!-- Titular Principal de Alto Impacto Comercial -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.12] mb-6 font-heading max-w-3xl">
        Hablemos de tu Negocio,
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-500 to-red-400 drop-shadow-[0_0_35px_rgba(239,68,68,0.4)]">
          No de Tecnicismos
        </span>
      </h1>

      <!-- Párrafo Persuasivo y Empático -->
      <p class="text-base sm:text-lg md:text-xl text-zinc-300 leading-relaxed mb-9 max-w-2xl font-sans">
        ¿Tienes un local, taller o empresa y sientes que pierdes ventas o tiempo en tareas manuales? Coordinemos una demostración directa de 15 minutos por WhatsApp y te muestro exactamente cómo podemos optimizarlo.
      </p>

      <!-- Botón Principal: Conversar por WhatsApp -->
      <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
        <a
          href="https://wa.me/56937508655?text=Hola,%20estuve%20revisando%20tu%20web%20y%20me%20gustaría%20conversar%20sobre%20mi%20negocio."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-crimson-glow inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl font-bold text-sm sm:text-base tracking-tight font-heading w-full sm:w-auto shadow-[0_0_30px_rgba(239,68,68,0.35)]"
        >
          <!-- Ícono de WhatsApp -->
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Contactar</span>
        </a>

        <!-- Botón secundario para scrollear al Sobre Mí -->
        <a
          href="#sobre-mi"
          class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl text-zinc-400 hover:text-white transition-all text-xs font-mono"
        >
          <span>Conoce mi enfoque de ingeniería</span>
          <span>↓</span>
        </a>
      </div>

    </div>

  </div>
</section>
